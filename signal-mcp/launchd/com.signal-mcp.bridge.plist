<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Optional: keeps the Signal archive current around the clock, even while Claude is closed.
  Replace the node path (`which node`) and the signal-mcp path. If you also use signal-cli,
  set SIGNAL_CLI_URL and SIGNAL_ACCOUNT below; with Signal Desktop alone, remove that block. Then:
    cp com.signal-mcp.bridge.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.signal-mcp.bridge.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.signal-mcp.bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/path/to/whatsapp-community-tools/signal-mcp/dist/index.js</string>
    <string>bridge</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SIGNAL_CLI_URL</key>
    <string>http://127.0.0.1:8080</string>
    <key>SIGNAL_ACCOUNT</key>
    <string>+15551234567</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/tmp/signal-mcp-bridge.log</string>
</dict>
</plist>
